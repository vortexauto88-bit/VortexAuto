{
  "expo": {
    "name": "VortexAuto",
    "slug": "vortexauto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vortexauto.salesreport"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.vortexauto.salesreport",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "VortexAuto",
      "shortName": "VortexAuto",
      "description": "Aplikasi Laporan Penjualan Otomotif"
    },
    "experiments": {
      "baseUrl": "/VortexAuto"
    },
    "plugins": [
      "expo-document-picker"
    ]
  }
}
